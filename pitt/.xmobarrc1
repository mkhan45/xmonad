Config {  font = "DejaVu Sans Mono 16"
	, borderColor = "black"
        , border = TopB
        , bgColor = "#252528"
        , fgColor = "grey"
        , position = Static { xpos = 2560, ypos = 0, width=1440, height=24 }
        , commands = [ Run Cpu ["-t", "CPU: <total>%", "3","-H","50","--normal","green","--high","red"] 20
                     , Run Memory ["-t","MEM: <usedratio>%"] 20
                     , Run Date "%a %b %_d %H:%M" "date" 500
                     , Run BatteryP ["BAT0"] ["-t", "<watts>W <left>%"] 60
                     , Run Com "/bin/sh" ["-c", "~/.config/xmonad/get_volume.sh"] "vol" 10
                     , Run XPropertyLog "_XMONAD_LOG_2"
                     ]
        , sepChar = "%"
        , alignSep = "}{"
        , template = "%_XMONAD_LOG_2% }{<fc=grey> VOL: %vol% | %cpu% | %memory% | %date%</fc>"
        }
